# Copy to .env and fill in real values. .env is gitignored.
# Never commit real credentials — use an app-specific password / OAuth
# token where the service supports it, and scope access to the minimum
# needed (see CLAUDE.md's Security invariants).

# France Travail API (register at francetravail.io)
FRANCE_TRAVAIL_ID=
FRANCE_TRAVAIL_SECRET=

# Read-only IMAP access to the mailbox/folder holding LinkedIn job alerts.
# Use an app-specific password, and scope it to a dedicated label/folder
# that contains only LinkedIn alert emails — nothing else.
IMAP_HOST=
IMAP_USER=
IMAP_APP_PASSWORD=

# Google Routes API key — commute times (transit, traffic-aware driving, bike).
# Enable the "Routes API" in a Google Cloud project with billing on, then create
# an API key. The free tier easily covers job-hunt volume; set a budget cap /
# quota so it can never charge. This is the ONE external service that receives
# your home coordinates (see docs/enrichment.md for why we consolidated onto
# Google and dropped the IDFM PRIM path). Commute *minutes* — never the address —
# are what flow downstream into scoring/digests/letters.
GOOGLE_ROUTES_KEY=
